package com.optimasc.definitions;

/** Represents the schema of a named item. 
 *  
 *  <p>A named item is any object, attribute, property, or element that has a name and
 *  is associated with a specific data type. Named items can represent attributes in LDAP,
 *  properties in XML, columns in SQL databases, or fields in data structures.</p>
 *  
 *  <p>Among others, this interface may be used to represent an 
 *  <code>AttributeTypeDescription</code> in LDAP (IETF RFC 4512).</p>
 *    
 *  <p>This interface extends {@link Definition}, inheriting all definition attributes.
 *  The following additional attributes are specific to item definitions:</p>
 *  
 *  <table border="1">
 *    <tr><th>Attribute name</th><th>Mandatory</th><th>Type</th><th>Description</th></tr>
 *    <tr><td>{@link #KEY_TYPE_NAME}</td><td>TRUE</td><td><code>String</code></td>
 *        <td>The type name or OBJECT IDENTIFIER of the data type for this item's values. 
 *            Must be set for valid item definitions.</td></tr>
 *    <tr><td>{@link #KEY_VALUE_TYPE}</td><td>TRUE</td><td><code>String</code></td>
 *        <td>Indicates whether this item supports a single value ({@link #VALUE_TYPE_SINGLE}), 
 *            unordered multiple values ({@link #VALUE_TYPE_BAG}), ordered multiple values 
 *            ({@link #VALUE_TYPE_SEQ}), or context-based alternative values ({@link #VALUE_TYPE_ALT}). 
 *            Default is {@link #VALUE_TYPE_SINGLE} if not explicitly set.</td></tr>
 *    <tr><td>{@link #KEY_READONLY}</td><td>TRUE</td><td><code>Boolean</code></td>
 *        <td>Indicates whether values of this item can be modified by user applications. 
 *            Default is <code>FALSE</code> (modifiable) if not explicitly set.</td></tr>
*    <tr><td>{@link #KEY_MAX_VALUE_LENGTH}</td><td>FALSE</td><td><code>Number</code></td>
 *        <td>Maximum length in characters (for strings) or octets (for binary data) 
 *            for values of this item. Represented as a {@link Number} instance (typically 
 *            {@link Integer} or {@link Long}). Optional; absence indicates no length restriction.</td></tr>
 *    <tr><td>{@link #KEY_CONTEXT_TYPE}</td><td>FALSE</td><td><code>String</code></td>
 *        <td>Specifies the context type for alternative values. Only valid and required 
 *            when {@link #KEY_VALUE_TYPE} is {@link #VALUE_TYPE_ALT}. Defines how to 
 *            select among alternative values (e.g., by language or location).</td></tr>
 *  </table>
 *  
 *  <h3>Single-Valued vs Multi-Valued Items</h3>
 *  
 *  <p>Items can be categorized based on their {@link #KEY_VALUE_TYPE}:</p>
 *  <ul>
 *    <li><b>Single-valued</b> ({@link #VALUE_TYPE_SINGLE}): Can store exactly one value. 
 *        Arrays and Lists are not permitted.</li>
 *    <li><b>Multi-valued</b> ({@link #VALUE_TYPE_BAG}, {@link #VALUE_TYPE_SEQ}, 
 *        {@link #VALUE_TYPE_ALT}): Can store multiple values, typically as arrays or Lists.</li>
 *  </ul>  
 *  
 *  <h3>Alternative Values and Context Types</h3>
 *  
 *  <p>The {@link #KEY_CONTEXT_TYPE} attribute is used when an item can have multiple
 *  alternative values, where each value is associated with a specific context (key).
 *  This is similar to:</p>
 *  <ul>
 *    <li>Contexts in ITU-T X.501</li>
 *    <li>LangAlt (language alternatives) in XMP</li>
 *    <li>Language tags in LDAP</li>
 *  </ul>
 *  
 *  <p>For example, a "description" item might have different text values for different
 *  languages. The context type would be {@link #CONTEXT_LANGUAGE}, and each value would
 *  be associated with a language code (e.g., "en", "fr", "de"). This is conceptually
 *  similar to a Map&lt;String, Object&gt; where the context value is the key.</p>
 *  
 *  <p>The following pre-defined context types are available:</p>
 *  
 *  <dl>
 *    <dt>{@link #CONTEXT_LANGUAGE}</dt>
 *    <dd>Language alternative using ISO 639-1 or ISO 639-2 language codes 
 *        (e.g., "en", "fr", "de")</dd>
 *    <dt>{@link #CONTEXT_LOCATION}</dt>
 *    <dd>Location alternative with values: "Home", "Office", or "Other" (case-insensitive)</dd>
 *  </dl>
 *  
 *  <p>Custom context types may also be defined for application-specific needs.</p>
 *    
 * @author Carl Eric Codere
 */
public interface ItemDefinition extends Definition
{
  
  
  /**
   * Key indicating whether this item's values can be modified by user applications.
   * 
   * <p>The value stored under this key is a {@link Boolean}:</p>
   * <ul>
   *   <li><code>TRUE</code> - Values are read-only and can only be modified by the system</li>
   *   <li><code>FALSE</code> - Values can be modified by user applications (default)</li>
   * </ul>
   * 
   * <p>This attribute is mandatory. If not explicitly set, the default is <code>FALSE</code>.</p>
   */  
  public static final String KEY_READONLY = "NO-USER-MODIFICATION";

  /**
   * Key indicating the value multiplicity and ordering for this item.
   * 
   * <p>The value stored under this key is a {@link String} that must be one of:</p>
   * <ul>
   *   <li>{@link #VALUE_TYPE_SINGLE} - Single value only</li>
   *   <li>{@link #VALUE_TYPE_BAG} - Multiple unordered values</li>
   *   <li>{@link #VALUE_TYPE_SEQ} - Multiple ordered values (sequence)</li>
   *   <li>{@link #VALUE_TYPE_ALT} - Multiple alternative values with context keys</li>
   * </ul>
   * 
   * <p>This attribute is mandatory. If not explicitly set, the default is 
   * {@link #VALUE_TYPE_SINGLE}.</p>
   */  
  public static final String KEY_VALUE_TYPE = "Value Type";

  /**
   * Key indicating the maximum length constraint for this item's values.
   * 
   * <p>The value stored under this key is a {@link Number} representing:</p>
   * <ul>
   *   <li>For strings: maximum number of characters</li>
   *   <li>For binary data (byte arrays): maximum number of octets</li>
   * </ul>
   * 
   * <p>This attribute is optional. If not present, there is no length restriction
   * on values.</p>
   */  
  public static final String KEY_MAX_VALUE_LENGTH = "X-MAX-VALUE-LENGTH";
  
  /**
   * Key for the type name or syntax identifier of this item's values.
   * 
   * <p>The value stored under this key is a {@link String} that is typically an
   * OBJECT IDENTIFIER in dotted decimal notation (e.g., "1.3.6.1.4.1.1466.115.121.1.15"),
   * though this implementation also accepts other string identifiers. This is
   * equivalent to LDAP-SYNTAX in ITU-T X.501.</p>
   * 
   * <p>This attribute is mandatory for valid item definitions. It identifies the
   * data type of the item's values.</p>
   */
  public static final String KEY_TYPE_NAME = "SYNTAX";
  
  
  /**
   * Key for the context type identifier used with alternative values.
   * 
   * <p>This attribute specifies how to distinguish between alternative values
   * when {@link #KEY_VALUE_TYPE} is {@link #VALUE_TYPE_ALT}. The context type
   * defines the "key" used to select the appropriate alternative value (e.g.,
   * language code, location identifier, ...).</p>
   * 
   * <p>The value stored under this key is a {@link String} identifier, typically
   * one of the pre-defined constants like {@link #CONTEXT_LANGUAGE} or 
   * {@link #CONTEXT_LOCATION}, though custom context types may be defined.</p>
   * 
   * <p>This attribute is:</p>
   * <ul>
   *   <li><b>Required</b> when {@link #KEY_VALUE_TYPE} is {@link #VALUE_TYPE_ALT}</li>
   *   <li><b>Not applicable</b> for other value types (single, bag, seq)</li>
   * </ul>
   */  
  public static final String KEY_CONTEXT_TYPE = "CONTEXT";
  
  /** 
   * Pre-defined context type for location-based alternatives.
   * 
   * <p>When this context type is used, alternative values are distinguished by
   * location. Typical context values include:</p>
   * <ul>
   *   <li>"Home" - Home or personal location</li>
   *   <li>"Office" - Work or business location</li>
   *   <li>"Other" - Other location</li>
   * </ul>
   * 
   * <p>Context value comparison is case-insensitive.</p>
   */  
  public static final String CONTEXT_LOCATION = "LocationAlt";
  
  /** 
   * Pre-defined context type for language-based alternatives.
   * 
   * <p>When this context type is used, alternative values are distinguished by
   * language using ISO 639-1 (two-letter) or ISO 639-2 (three-letter) language codes.</p>
   * 
   * <p>Examples: "en" (English), "fr" (French), "de" (German), "eng", "fra", "deu"</p>
   */
   public static final String CONTEXT_LANGUAGE = "LangAlt";
  
   /** 
    * Value type constant indicating a single value.
    * 
    * <p>When this value type is used, the item can have exactly one value.
    * Arrays and Lists are not permitted. This is the only single-valued type;
    * all other value types ({@link #VALUE_TYPE_BAG}, {@link #VALUE_TYPE_SEQ},
    * {@link #VALUE_TYPE_ALT}) are multi-valued.</p>
    */   
  public static final String VALUE_TYPE_SINGLE = "";
  
  /**  
   * Value type constant indicating an unordered collection of values (bag).
   * 
   * <p>When this value type is used, the item is <b>multi-valued</b> and can store
   * multiple values with no defined order. Values are typically represented as 
   * arrays or {@link java.util.List} instance. The order in which values are stored or 
   * retrieved is not significant.</p>
   * 
   * <p>This definition is taken from RDF.</p>
   */
  public static final String VALUE_TYPE_BAG = "Bag";
  
  /**  
   * Value type constant indicating an ordered sequence of values.
   * 
   * <p>When this value type is used, the item is <b>multi-valued</b> and can store
   * multiple values in a specific order. Values are typically represented as arrays 
   * or Lists where order is significant and must be preserved. Duplicate values are 
   * allowed, and their position in the sequence is meaningful.</p>
   * 
   * <p>From a <b>storage and validation perspective</b>, items with this value type
   * accept and store multiple values (arrays or {@link java.util.List} instance). 
   * The sequence order must be maintained during storage and retrieval operations.</p>
   * 
   * <p>This definition is taken from RDF.</p>
   */
  public static final String VALUE_TYPE_SEQ = "Seq";
  
  
  /**  
   * Value type constant indicating alternative values with context keys.
   * 
   * <p>When this value type is used, the item is <b>multi-valued</b> and stores
   * multiple alternative values, each associated with a context key (as specified 
   * by {@link #KEY_CONTEXT_TYPE}). Although multiple values are stored, typically 
   * only one value is selected and used at runtime based on the current context.</p>
   * 
   * <p>From a <b>storage and validation perspective</b>, items with this value type
   * are multi-valued and should be as a {@link java.util.Map} instance. From a <b>usage perspective</b>,
   * applications select and present a single appropriate alternative based on context.</p>
   * 
   * <p>For example, with context type {@link #CONTEXT_LANGUAGE}, the item might store
   * values for "en", "fr", and "de". The storage contains all three alternatives 
   * (multi-valued), but an English-speaking user would only see the "en" value 
   * (single value in use).</p>
   * 
   * <p>This definition is taken from RDF Alternatives.</p>
   */
  public static final String VALUE_TYPE_ALT = "Alt";
  
  
  /** 
   * Returns the type name or syntax identifier for this item's values.
   * 
   * <p>This typically returns an OBJECT IDENTIFIER that identifies the data type
   * definition for values of this item.</p>
   *   
   * @return The type name, or <code>null</code> if not set (invalid item definition).
   */
  public String getTypeName();
  
  /** 
   * Returns the context type identifier for alternative values.
   * 
   * <p>This value is only meaningful when {@link #getValueType()} returns
   * {@link #VALUE_TYPE_ALT}. It specifies how alternative values are distinguished
   * (e.g., by language, by location).</p>
   *   
   * @return The context type identifier, or <code>null</code> if no context type
   *         is associated with this item (which is normal for non-alternative value types).
   */
  public String getContextType();
  
  
  /** 
   * Returns the value type indicating multiplicity and ordering.
   * 
   * <p>This method always returns a non-null value, which will be one of:</p>
   * <ul>
   *   <li>{@link #VALUE_TYPE_SINGLE} - Single value</li>
   *   <li>{@link #VALUE_TYPE_BAG} - Multiple unordered values</li>
   *   <li>{@link #VALUE_TYPE_SEQ} - Multiple ordered values</li>
   *   <li>{@link #VALUE_TYPE_ALT} - Alternative values with context</li>
   * </ul>
   *   
   * @return The value type. Never returns <code>null</code> for valid item definitions.
   */
  public String getValueType();
  
  /** 
   * Returns whether this item allows only a single value.
   * 
   * <p>This method returns <code>true</code> only when {@link #getValueType()} 
   * equals {@link #VALUE_TYPE_SINGLE}.</p>
   * 
   * <p>Items with value types {@link #VALUE_TYPE_BAG}, {@link #VALUE_TYPE_SEQ}, 
   * or {@link #VALUE_TYPE_ALT} are all considered multi-valued and will return
   * <code>false</code>. This means they can store multiple values, typically 
   * as arrays or Lists.</p>
   * 
   * <p><b>Note:</b> Items with {@link #VALUE_TYPE_ALT} return <code>false</code>
   * because they store multiple alternatives, even though only one alternative 
   * is typically selected for use at runtime based on context.</p>
   * 
   * @return <code>true</code> if only one value can be stored (single-valued), 
   *         <code>false</code> if multiple values can be stored (multi-valued).
   */
  public boolean isSingleValued();
  
  /** 
   * Returns whether this item's values are read-only.
   * 
   * <p>Read-only items can only be modified by the system, not by user applications.</p>
   * 
   * @return <code>true</code> if values are read-only, 
   *         <code>false</code> if values can be modified by users.
   */
  public boolean isReadOnly();
  
  
  /** 
   * Returns whether this item's values are ordered.
   * 
   * <p>This is a convenience method equivalent to checking if
   * {@link #getValueType()} equals {@link #VALUE_TYPE_SEQ}.</p>
   * 
   * <p>When values are ordered, their position is significant and duplicates are
   * allowed. When values are unordered, they may be presented in any order and
   * duplicates typically have no special meaning.</p>
   * 
   * @return <code>true</code> if values are ordered (sequence),
   *         <code>false</code> otherwise.
   */
  public boolean isOrdered();
  
  

}
